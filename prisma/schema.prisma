generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String                @id @default(uuid())
  uid              String                @unique
  email            String                @unique
  firstName        String
  lastName         String
  phone            String?
  role             String
  nationalId       String?
  sex              String?
  currentAddress   String?
  isActive         Boolean               @default(true)
  emailVerified    Boolean               @default(false)
  setupCompleted   Boolean               @default(false)
  passwordSet      Boolean               @default(false)
  profilePicture   String?
  fcmTokens        Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  lastTokenUpdated DateTime?
  companyId        String?
  region           String?
  invitationSent   Boolean               @default(false)
  invitationSentAt DateTime?
  createdBy        String?
  sessionVersion   Int                   @default(1)
  preferences      Json?
  activities       ActivityLog[]
  bookings         Booking[]
  sentMessages     ChatMessage[]
  charterRequests  GroupCharterRequest[]
  groupRequests    GroupRequest[]
  notifications    Notification[]
  reservations     SeatReservation[]
  company          Company?              @relation("CompanyStaff", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  conversations    Conversation[]        @relation("UserConversations")
  chatterSchedules ChatterSchedule[]     @relation("ChatterScheduleRep")
}

model Operator {
  id                String     @id @default(uuid())
  uid               String     @unique
  companyId         String
  companyName       String
  email             String     @unique
  name              String
  role              String     @default("operator")
  status            String     @default("active")
  invitationSent    Boolean    @default(false)
  invitationSentAt  DateTime?
  signupCompletedAt DateTime?
  createdBy         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  regionId          String?
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  region            Region?    @relation(fields: [regionId], references: [id])
  schedules         Schedule[] @relation("OperatorSchedules")
  buses             Bus[]      @relation("OperatorBuses")
  routes            Route[]    @relation("OperatorRoutes")

  @@index([companyId])
  @@index([status])
  @@index([role])
  @@index([uid])
  @@index([regionId])
}

model Company {
  id                        String              @id @default(uuid())
  name                      String
  email                     String
  phone                     String?
  address                   String?
  description               String?
  logo                      String?
  status                    String              @default("active")
  planType                  String              @default("basic")
  maxBuses                  Int                 @default(6)
  maxRoutes                 Int                 @default(3)
  contactSettings           Json?
  paymentSettings           Json?
  notificationSettings      Json?
  operatingHours            Json?
  setupCompleted            Boolean             @default(false)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  returnTripDiscountPercent Float               @default(0)
  activities                ActivityLog[]
  bookings                  Booking[]
  bookingSegments           BookingSegment[]    @relation("BookingSegmentCompany")
  buses                     Bus[]
  conversations             Conversation[]
  dailyReports              DailyReport[]
  charterQuotes             GroupCharterQuote[]
  groupRequests             GroupRequest[]
  operators                 Operator[]
  regions                   Region[]
  routes                    Route[]
  schedules                 Schedule[]
  scheduleTemplates         ScheduleTemplate[]
  staff                     User[]              @relation("CompanyStaff")
  charterRequests           GroupCharterRequest[]

  @@index([status])
}

model Region {
  id        String     @id @default(uuid())
  name      String
  code      String?    @unique
  companyId String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  operators Operator[]
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  routes    Route[]

  @@index([companyId])
  @@index([isActive])
}

model Bus {
  id                  String             @id @default(uuid())
  companyId           String
  licensePlate        String
  busType             String
  capacity            Int
  amenities           Json?
  status              String             @default("active")
  yearOfManufacture   Int?
  registrationDetails Json?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  fuelType            String?
  insuranceDetails    Json?
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  conductorIds        String[]           @default([])
  images              String[]           @default([])
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  schedules           Schedule[]
  scheduleTemplates   ScheduleTemplate[]
  conductors          Operator[]         @relation("OperatorBuses")
}

model Route {
  id                String             @id @default(uuid())
  companyId         String
  name              String
  origin            String
  destination       String
  distance          Int
  duration          Int
  baseFare          Int
  pricePerKm        Int?
  stops             Json?
  isActive          Boolean            @default(true)
  status            String             @default("active")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  regionId          String?
  groupRequests     GroupRequest[]
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  region            Region?            @relation(fields: [regionId], references: [id])
  schedules         Schedule[]
  scheduleTemplates ScheduleTemplate[]
  operators         Operator[]         @relation("OperatorRoutes")
  bookings          Booking[]


  @@index([origin])
  @@index([destination])
  @@index([isActive])
  @@index([regionId])
}

model Schedule {
  id                   String               @id @default(uuid())
  companyId            String
  busId                String
  routeId              String
  operatorId           String?
  departureDateTime    DateTime
  arrivalDateTime      DateTime
  departureLocation    String?
  arrivalLocation      String?
  availableSeats       Int
  bookedSeats          Json?
  price                Int
  status               String               @default("active")
  tripStatus           String               @default("scheduled")
  isActive             Boolean              @default(true)
  isArchived           Boolean              @default(false)
  isCompleted          Boolean              @default(false)
  actualDepartureTime  DateTime?
  actualArrivalTime    DateTime?
  currentStopIndex     Int                  @default(0)
  currentStopId        String?
  departedStops        String[]             @default([])
  tripStartedAt        DateTime?
  tripCompletedAt      DateTime?
  delayMinutes         Int                  @default(0)
  tripNotes            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  baseFare             Int?
  fare                 Int?
  segmentPrices        Json?
  reminderSent         Boolean              @default(false)
  boardingReminderSent Boolean              @default(false)
  activities           ActivityLog[]
  bookings             Booking[]
  bookingSegments      BookingSegment[]     @relation("BookingSegmentSchedule")
  groupRequests        GroupRequest[]
  bus                  Bus                  @relation(fields: [busId], references: [id])
  company              Company              @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  operator             Operator?            @relation("OperatorSchedules", fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  route                Route                @relation(fields: [routeId], references: [id])
  reservations         SeatReservation[]
  positionSamples      TripPositionSample[]
  charterRequests      GroupCharterRequest[] @relation("ChatterResultSchedule")

  @@index([companyId])
  @@index([busId])
  @@index([routeId])
  @@index([operatorId])
  @@index([departureDateTime])
  @@index([status])
  @@index([availableSeats])
}

model Booking {
  id                String           @id @default(uuid())
  bookingReference  String           @unique
  userId            String
  scheduleId        String?
  chatterScheduleId String?
  companyId         String?
  totalAmount       Int
  currency          String           @default("MWK")
  bookingStatus     String           @default("pending")
  paymentStatus     String           @default("pending")
  passengerDetails  Json?
  seatNumbers       Json?
  paidAt            DateTime?
  bookingDate       DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  cancellationDate  DateTime?
  confirmedDate     DateTime?
  contactEmail      String?
  contactPhone      String?
  createdAt         DateTime         @default(now())
  routeId           String?
  isWalkOn          Boolean          @default(false)
  bookedBy          String?
  originStopId      String?
  destinationStopId String?
  metadata          Json?
  returnDate        DateTime?
  reviewRating      Int?
  reviewText        String?
  discountAmount    Int?             @default(0)
  discountPercent   Float?           @default(0)
  company           Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  schedule          Schedule?        @relation(fields: [scheduleId], references: [id])
  chatterSchedule   ChatterSchedule? @relation(fields: [chatterScheduleId], references: [id])
  user              User             @relation(fields: [userId], references: [id])
  route             Route?           @relation(fields: [routeId], references: [id], onDelete: Restrict)
  segments          BookingSegment[] @relation("BookingSegmentBooking")
  payments          Payment[]

  @@index([scheduleId])
  @@index([chatterScheduleId])
  @@index([userId])
  @@index([companyId])
}

model BookingSegment {
  id                String            @id @default(uuid())
  bookingId         String
  companyId         String
  scheduleId        String
  segmentIndex      Int
  date              DateTime
  seatNumbers       Json
  passengerCount    Int
  price             Int
  currency          String            @default("MWK")
  originStopId      String?
  destinationStopId String?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  booking           Booking           @relation("BookingSegmentBooking", fields: [bookingId], references: [id])
  company           Company           @relation("BookingSegmentCompany", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  schedule          Schedule          @relation("BookingSegmentSchedule", fields: [scheduleId], references: [id])
  reservations      SeatReservation[] @relation("SeatReservationBookingSegment")

  @@index([bookingId])
  @@index([scheduleId])
  @@index([companyId])
}

model Payment {
  id                String   @id @default(uuid())
  paymentId         String   @unique
  bookingId         String?
  amount            Int
  currency          String   @default("MWK")
  customerEmail     String?
  customerPhone     String?
  checkoutUrl       String?
  status            String   @default("initiated")
  paymentType       String?
  provider          String   @default("paychangu")
  txRef             String?
  metadata          Json?
  paychanguResponse Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  booking           Booking? @relation(fields: [bookingId], references: [id])

  @@index([txRef])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  priority  String    @default("medium")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  actionUrl String?
  data      Json?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Conversation {
  id           String        @id @default(uuid())
  companyId    String
  name         String?
  isBroadcast  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  participants User[]        @relation("UserConversations")

  @@index([companyId])
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String?
  mediaUrl       String?
  mediaType      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

model SeatReservation {
  id                String          @id @default(uuid())
  scheduleId        String
  userId            String
  seatNumbers       Json
  status            String          @default("reserved")
  expiresAt         DateTime
  createdAt         DateTime        @default(now())
  bookingSegmentId  String?
  destinationStopId String?
  originStopId      String?
  bookingSegment    BookingSegment? @relation("SeatReservationBookingSegment", fields: [bookingSegmentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  schedule          Schedule        @relation(fields: [scheduleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([scheduleId])
  @@index([userId])
  @@index([bookingSegmentId])
}

model ScheduleTemplate {
  id            String   @id @default(uuid())
  companyId     String
  routeId       String
  busId         String
  departureTime String
  arrivalTime   String
  daysOfWeek    Json?
  price         Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bus           Bus      @relation(fields: [busId], references: [id])
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  route         Route    @relation(fields: [routeId], references: [id])

  @@index([routeId])
  @@index([companyId])
  @@index([busId])
}

model ActivityLog {
  id          String    @id @default(uuid())
  userId      String
  companyId   String?
  scheduleId  String?
  action      String
  description String
  metadata    Json?
  createdAt   DateTime  @default(now())
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  schedule    Schedule? @relation(fields: [scheduleId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([scheduleId])
}

model GroupRequest {
  id             String   @id @default(uuid())
  userId         String
  companyId      String
  scheduleId     String
  routeId        String
  organizerName  String
  organizerPhone String
  seatsRequested Int
  totalPrice     Int
  status         String   @default("pending")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  route          Route    @relation(fields: [routeId], references: [id])
  schedule       Schedule @relation(fields: [scheduleId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
}

model DailyReport {
  id                 String   @id @default(uuid())
  companyId          String
  date               DateTime
  createdBy          String
  createdByName      String
  totalSchedules     Int
  completedSchedules Int
  totalBookings      Int
  paidBookings       Int
  boardedPassengers  Int
  noShowPassengers   Int
  totalRevenue       Int
  avgOccupancyRate   Float
  reportData         Json
  createdAt          DateTime @default(now())
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([companyId])
  @@index([date])
}

model Promotion {
  id            String   @id @default(uuid())
  code          String   @unique
  title         String
  description   String
  discountValue Int
  discountType  String   @default("percentage")
  minPurchase   Int?     @default(0)
  maxDiscount   Int?
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([code])
  @@index([isActive])
}

model GroupCharterRequest {
  id                  String              @id @default(uuid())
  userId              String
  organizerName       String
  organizerPhone      String
  origin              String
  destination         String
  departureDate       DateTime
  departureTime       String?
  estimatedPax        Int
  status              String              @default("pending")
  charterType         String              @default("student")
  notes               String?
  budget              Int?
  seatsRequested      Int?
  proposedFare        Int?
  contactPhone        String?
  pickupPoint         String?
  dropoffPoint        String?
  confirmedPrice      Int?
  resultingScheduleId String?
  companyId           String?
  charterSource       String              @default("charter")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  quotes              GroupCharterQuote[]
  user                User                @relation(fields: [userId], references: [id])
  resultingSchedule   Schedule?           @relation("ChatterResultSchedule", fields: [resultingScheduleId], references: [id])
  company             Company?            @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([resultingScheduleId])
  @@index([charterSource])
  @@index([companyId])
}

model GroupCharterQuote {
  id         String              @id @default(uuid())
  requestId  String
  companyId  String
  price      Int
  notes      String?
  status     String              @default("pending")
  validUntil DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  request    GroupCharterRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@index([companyId])
}

model TripPositionSample {
  id                String           @id @default(uuid())
  scheduleId        String?
  chatterScheduleId String?
  latitude          Float
  longitude         Float
  accuracy          Float?
  heading           Float?
  speed             Float?
  source            String           @default("rider")
  createdAt         DateTime         @default(now())
  schedule          Schedule?        @relation(fields: [scheduleId], references: [id])
  chatterSchedule   ChatterSchedule? @relation(fields: [chatterScheduleId], references: [id])

  @@index([scheduleId])
  @@index([chatterScheduleId])
  @@index([createdAt])
}

model ChatterSchedule {
  id              String               @id @default(uuid())
  repUserId       String
  busName         String
  origin          String
  destination     String
  travelDate      DateTime
  departureTime   String               @default("08:00")
  arrivalTime     String?
  fare            Int
  totalSeats      Int
  contactPhone    String
  pickupPoint     String?
  dropoffPoint    String?
  notes           String?
  images          String[]
  status          String               @default("active")
  isArchived      Boolean              @default(false)
  archivedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  rep             User                 @relation("ChatterScheduleRep", fields: [repUserId], references: [id])
  bookings        Booking[]
  positionSamples TripPositionSample[]

  @@index([repUserId])
  @@index([status])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
}

